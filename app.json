{
  "expo": {
    "name": "GMarket",
    "slug": "gmarket-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/gmarket-icon.png",
    "scheme": "gmarketapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/gmarket-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "android": {
        "image": "./assets/images/gmarket-splash-android.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gmarket.app",
      "buildNumber": "7",
      "associatedDomains": [
        "applinks:www.gmbissau.com",
        "applinks:gmbissau.com"
      ],
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "O GMarket usa Face ID para proteger o acesso ao GPay.",
        "NSMicrophoneUsageDescription": "O GMarket usa o microfone exclusivamente para gravar e enviar mensagens de áudio no suporte.",
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "waze",
          "maps"
        ]
      }
    },
    "android": {
      "package": "com.gmarket.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/gmarket-adaptive-foreground.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "www.gmbissau.com",
              "pathPrefix": "/"
            },
            {
              "scheme": "https",
              "host": "gmbissau.com",
              "pathPrefix": "/"
            }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/gmarket-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.gmbissau.com"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "ios": {
            "image": "./assets/images/gmarket-splash.png",
            "imageWidth": 300,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff"
          },
          "android": {
            "image": "./assets/images/gmarket-splash-android.png",
            "imageWidth": 200,
            "backgroundColor": "#ffffff"
          }
        }
      ],
      "expo-asset",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o GMarket use sua localização para encontrar seu endereço de entrega."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o GMarket aceda às suas fotos para anunciar imóveis.",
          "cameraPermission": "Permita que o GMarket use a câmara para fotografar imóveis."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "O GMarket usa o microfone exclusivamente para gravar e enviar mensagens de áudio no suporte."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/gmarket-icon.png",
          "color": "#0D47A1",
          "defaultChannel": "gmarket-default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          },
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "O GMarket usa Face ID para proteger o acesso ao GPay."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Permita que o GMarket detecte o movimento do telemóvel para a experiência Mágica."
        }
      ],
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/20c5ce91-b451-4f2b-ac29-3a1133c0deed",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "20c5ce91-b451-4f2b-ac29-3a1133c0deed"
      }
    },
    "owner": "deiguscissoko"
  }
}
