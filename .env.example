# Google Maps SDK (obrigatório para MapView em builds Android / iOS / preview)
# Também criar no EAS: eas env:create --name GOOGLE_MAPS_API_KEY --environment preview --visibility sensitive
GOOGLE_MAPS_API_KEY=

# Backend Express (opcional — em __DEV__ usa o IP do Metro/Expo na mesma rede)
# Em preview/production o app usa Railway se esta variável não existir no EAS:
# EXPO_PUBLIC_API_URL=https://gmarket-backend-production.up.railway.app
# Só para Expo Go na LAN:
# EXPO_PUBLIC_API_URL=http://192.168.31.33:3001

# Site público (links de partilha / Universal Links). Padrão: https://www.gmbissau.com
# EXPO_PUBLIC_WEB_URL=https://www.gmbissau.com
